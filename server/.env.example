# =============================================================================
#  cf_bot environment
#
#  Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#  The bot itself reads the real process environment -- it does not parse .env --
#  so export these or have systemd/your shell load them.
# =============================================================================

# --- Bitget credentials. All three are required; Bitget has no two-field auth.
# The key must have READ + TRADE permission ONLY.
# Startup aborts if the key reports withdrawal or transfer rights.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- Operating mode: demo | live
# Unset or empty  -> demo. `live` is never a fallback.
# demo -> the bot is structurally forbidden from transmitting an order.
# live -> real funds.
MODE=demo

# --- Required ONLY when MODE=live. Must be exactly the lowercase string `yes`.
# Any other value, including "true" or "YES", refuses to start.
# I_UNDERSTAND_THIS_TRADES_REAL_MONEY=yes

# --- Kill switch. Set to 1/true/yes to halt: the bot cancels all orders,
# flattens all positions and exits non-zero.
# Exists for hosts like Render where you have no shell to `touch KILL`.
CF_KILL=0
