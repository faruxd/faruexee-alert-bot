# =============================================================
#   FARUEXEE TRADE BOT  —  environment template
# =============================================================
#   Copy to .env and fill in. .env is gitignored — never commit it.
#
#       cp .env.example .env
#
#   Create the Bitget API key yourself at:
#     Bitget -> API Management -> Create API key
#
#   Key permissions:
#     - enable "Trade" (needed to place and cancel orders)
#     - do NOT enable "Withdraw"
#     - bind your IP address if the bot runs from a fixed host
# =============================================================

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Reuse the same webhook as the alert bot, or make a separate channel.
DISCORD_WEBHOOK=


# ── MASTER SWITCH ────────────────────────────────────────────
# Leave false until smoke_test.py looks right and you have watched
# a dry run for a while. Setting this true sends real orders.
LIVE_TRADING=false
DRY_RUN=true


# ── SCOPE ────────────────────────────────────────────────────
TRADE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,LINKUSDT,LTCUSDT,AVAXUSDT,ADAUSDT,SUIUSDT,NEARUSDT,XAUUSDT,XAGUSDT
TRADE_TIMEFRAMES=4H,1H
CHECK_INTERVAL=120


# ── RISK ─────────────────────────────────────────────────────
RISK_PER_TRADE=0.02
MAX_CONCURRENT=3
MAX_PORTFOLIO_RISK=0.06
MAX_DAILY_LOSS=0.06
MIN_EQUITY_FRACTION=0.70
MIN_EQUITY_USDT=20

LEVERAGE=10
MARGIN_MODE=isolated
MAX_NOTIONAL_X_EQUITY=3.0
MAX_MARGIN_FRACTION=0.30
MAX_ENTRY_DISTANCE=0.05


# ── ORDER LIFECYCLE ──────────────────────────────────────────
ORDER_FORCE=gtc
ORDER_TTL_HOURS=48
TP1_SPLIT=0.50
TP2_SPLIT=0.30
TP3_SPLIT=0.20
MOVE_SL_TO_BE=true
BE_OFFSET_R=0.05
TRIGGER_TYPE=mark_price


# ── STRATEGY ─────────────────────────────────────────────────
LOOKBACK=20
IMPULSE_STRENGTH=1.5
TREND_STABILITY=2
VOLUME_MULT=1.5
REQUIRE_VOLUME=true
USE_BASE_CANDLE=true
USE_ATR_SL=true
ATR_LEN=14
ATR_MULT=0.5
MIN_RR=1.5
TP_MULTI=2.0
ZONE_MAX_AGE=300
BREACH_BUF_MULT=0.1
FVG_RECENT_BARS=100

# Keep HTF_BIAS_MODE=ema. "structure" cannot resolve on the daily —
# Bitget serves only 90 daily candles and a 20/20 pivot needs 41 bars
# per pivot plus two consecutive pivots to set a trend, so it would
# block every 4H entry permanently.
REQUIRE_HTF=true
HTF_BIAS_MODE=ema
HTF_EMA_LEN=50
HTF_FLAT_BLOCKS=false
